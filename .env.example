# ==============================================================================
# Notary: ortam değişkenleri (CONTRACT.md v2)
# ==============================================================================

# Solana RPC (devnet). Genel RPC hızlı sorguda 429 verir; Helius/Alchemy gibi ayrı bir anahtar önerilir.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Deploy edilmiş Notary programının kimliği (docs/deployment.json).
# Frontend için VITE_PROGRAM_ID, agent'lar ve backend için PROGRAM_ID.
PROGRAM_ID=

# Relayer (backend/app/relay.py): ücreti ödeyen cüzdan. Base58 ya da JSON bayt dizisi. Boşsa backend/keys/ altında üretilir.
SOLANA_PRIVATE_KEY=
# IP başına dakikada en fazla istek ve bakiyenin altında relay'in durduğu eşik (lamport)
RELAY_RATE_LIMIT=10
RELAY_MIN_LAMPORTS=10000000
# Relayer'ın bir işlem için ödemeyi kabul ettiği en yüksek öncelik ücreti (lamport; cüzdanın eklediği ComputeBudget talimatları)
RELAY_MAX_PRIORITY_LAMPORTS=250000
# Vercel gibi çok örnekli ortamlarda ortak sayaç için (opsiyonel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Agent'lar (agents/): anahtarlar agents/keys/ altında üretilir; SOLANA_RPC_URL ve PROGRAM_ID yeterli.
