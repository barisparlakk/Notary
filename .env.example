# ==============================================================================
# Notary Environment Configuration
# ==============================================================================

# Backend Port ve Host
PORT=8000
HOST=0.0.0.0

# SQLite Veritabanı Yolu
DB_PATH=notary.db

# Solana Devnet Yapılandırması
SOLANA_RPC_URL=https://api.devnet.solana.com

# Solana Cüzdan Gizli Anahtarı (Opsiyonel - Boş bırakılırsa keys/ altında otomatik üretilir)
# Format: Base58 string (örn. 5Mii...) veya JSON bayt dizisi [12,34,...]
SOLANA_PRIVATE_KEY=

# Frontend Entegrasyonu için Backend API URL
API_URL=http://localhost:8000

# ==============================================================================
# v2 (CONTRACT.md v2): Solana PDA kanıtları
# ==============================================================================
# Deploy edilmiş Notary programının kimliği (docs/deployment.json). Frontend için VITE_PROGRAM_ID, agent'lar için PROGRAM_ID.
PROGRAM_ID=
# Relayer (backend/app/relay.py): ücreti ödeyen cüzdan SOLANA_PRIVATE_KEY'dir; hız sınırı IP başına dakikada:
RELAY_RATE_LIMIT=10
# Agent'lar (agents/onchain.py, agents/demo_v2.py): SOLANA_RPC_URL ve PROGRAM_ID yeterli; anahtarlar agents/keys/ altında üretilir.
