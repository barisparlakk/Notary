        },
        {
          "name": "expires_at",
          "type": "i64"
        }
      ]
    },
    {
      "name": "revoke_attestation",
      "docs": [
        "Yayıncı kendi beyanını geri çeker. Zaman zincirin saatidir; geri alma yok (yenilemek için `attest_identity`)."
      ],
      "discriminator": [
