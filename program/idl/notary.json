            "array": [
              "u8",
              32
            ]
          }
        },
        {
          "name": "signers",
          "type": {
            "vec": "pubkey"
          }
        }
      ]
    },
    {
      "name": "co_sign",
      "docs": [
        "Sözleşmedeki bir tarafın imzası. İmza, işlemin kendi imzasıdır; zaman zincirin saatidir."
      ],
      "discriminator": [
        185,
